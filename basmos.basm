; ============================================================================
; basmos.basm - the ENTIRE OS in ONE 512-byte sector.
; SPDX-License-Identifier: BSD-3-Clause
; Copyright (c) 2026, F E R M I ∞ H A R T <contact@fermihart.com>
;
; boot + Protected Mode 32 + paging PSE + IDT exception-safe + PIC/PIT +
; 2 tasks + SPSC IPC (256-byte ring) + VGA, assembled entirely with BASM.
; No INT 13h: the BIOS has already loaded this sector at 0x7C00.
;
; TWO PERSONALITIES, ONE SOURCE:
;   metal (default):  basm -f bin -o basmos.bin basmos.basm
;                     classic BIOS boot sector, 512 bytes with 0xAA55.
;   contract (-D):    basm -f bin -DBEMU_CONTRACT -o basmos-vm.bin basmos.basm
;                     "boot without boot": bemu-nano enters PM32+paging DIRECTLY
;                     (the GDT, PD, CR3, CR0, CR4, and segments are machine state
;                     written by the VMM). The guest omits the real-mode prologue,
;                     GDT, paging, PIC, and PIT; only the product remains: the IDT,
;                     preemptive scheduler, IPC, and tasks.
;
; Build: basm -f bin -o basmos.bin basmos.basm
; Run:   make run   /   Verify: make verify
;
; Round H (hardening + code golf, no features removed):
;   H1  ESP builds IDT entries 0..34 backward; faults become fail-stop
;   H2  PIC remapped to 0x20 and PIT initialized; IRQ0 does not collide with #DF
;   H3  CR4 preserved; no push uses the stack inherited from the BIOS
;   H4  scheduler = xchg esp,[other_sp] + popad + iretd
;   H5  IPC cursors reside in each endpoint's saved ECX (frame slot +24)
;   H6  a full ring discards the new byte without corrupting empty/full state
;   H7  tasks use hlt: 3/6/9 now proves physical preemption by the PIT
;   H8  IDT/ring/page directory/stack in low RAM, away from the EBDA
;   H9  yield=int 32, send=int 33, recv=int 34
;
; Round I (the asynchronous preemption proof, metal personality only):
;   I1  task0 is CPU-bound: its loop never executes hlt, never yields; every
;       task1 slice is therefore an asynchronous IRQ0 preemption of a task
;       that was mid-computation, not sleeping (supersedes H7 on metal)
;   I2  the timer handler increments a heartbeat byte at 0x6FC on every
;       serviced tick; a frozen heartbeat betrays a dead timer on any
;       executor (the initial RAM value is irrelevant: the proof is the delta)
;   I3  the bEMU contract keeps H7 semantics untouched: time there is a
;       machine service requested by hlt, so basmos-vm.bin stays byte-identical
;
; Round J (bounded task data domains):
;   J1  task0 DS covers only 0x800..0x8FF; task1 DS covers 0x900..0x9FF
;   J2  SS remains flat, so interrupt frames and the overlapping task stacks do
;       not acquire incorrect double-based addresses during a context switch
;   J3  handlers use flat ES for kernel data; tasks use a VGA-only GS descriptor
;   J4  EBP carries each task's DS selector through pushad/popad
;
; Round K (bounded task code windows, metal personality):
;   K1  task0 CS (0x30) covers only task0's own bytes; task1 CS (0x38) covers
;       only task1's; handlers keep entering through the flat 0x08 gate selector
;   K2  a 5-byte retf prologue enters task0 through its own code window
;   K3  t1frame ships task1's CS directly, so the first iretd loads it
;   K4  runaway execution beyond a task's window raises #GP13 at the fetch;
;       the bEMU contract keeps flat code (machine-supplied identity) and
;       basmos-vm.bin stays byte-identical
;
; Memory map (all accesses remain within the 4 MB identity-mapped PDE):
;   0x00500  IDT (35 gates)              0x00620  GDT (contract: written by VMM)
;   0x006FC  heartbeat tick counter      0x00700  ring IPC (256 bytes)
;   0x00800  task0 data domain (256 B)   0x00900  task1 data domain (256 B)
;   0x01000  page directory + stack0     0x07C00  image (this sector)
;   0xB8000  VGA text
; ============================================================================

%ifdef BEMU_CONTRACT
BITS 32                     ; the VMM has already entered PM32 with paging enabled
%else
BITS 16
%endif
org 0x7C00
section .text

%ifndef BEMU_CONTRACT
start:
    cli
    xor ax, ax
    mov ds, ax              ; lgdt uses DS:offset in real mode
    lgdt [gdt]
    mov eax, cr0
    inc ax                  ; PE=0 in real mode: inc ax is equivalent to or eax,1
    mov cr0, eax
    jmp 0x08:pm
%endif

; --------------------------------------------------------------- Protected PM
BITS 32
pm:
%ifndef BEMU_CONTRACT
    mov eax, 0x10           ; do not touch the stack before SS is known
    mov ds, ax
    mov ss, ax
%endif

    ; H1: build the IDT backward using push. The three service gates are pushed
    ; first, followed by 32 identical exception gates.
    ; The service handlers share page 0x7D; timer/exceptions share page 0x7C.
    ; AX is reloaded at that one page crossing; AL handles the rest.
    mov esp, 0x00618        ; IDT_BASE + 35*8
    xor edx, edx
    mov dh, 0x8E            ; offset_hi=0, present interrupt gate, DPL0
    mov eax, sys_recv + 0x80000
    push edx
    push eax                ; vector 34: recv
    mov al, sys_send
    push edx
    push eax                ; vector 33: send
    mov ax, timer_handler
    push edx
    push eax                ; vector 32: IRQ0 / yield
%ifdef BEMU_CONTRACT
    mov al, exception_handler ; contract handlers share one 256-byte page
%else
    mov ax, exception_handler ; metal handler must not inherit timer's high byte
%endif
    push 32
    pop ecx
.idt_fill:
    push edx
    push eax
    db 0xE2, 0xFC           ; loop -4 (BASM does not yet support loop)
    mov word [0x00568], gp_handler ; vector 13 has an independently provable gate
    lidt [idtr]

%ifndef BEMU_CONTRACT
    mov eax, cr4            ; enable PSE without clearing firmware state
    or al, 0x10
    mov cr4, eax

    ; One identity-mapped PSE PDE covers the first 4 MB.
    mov eax, 0x01000
    mov dword [eax], 0x83   ; present | rw | PS
    mov cr3, eax
    mov esp, eax            ; stack0 grows below the page directory
    mov eax, cr0
    db 0x0F, 0xBA, 0xE8, 31 ; bts eax,31: CR0.PG (BASM does not yet support bts)
    mov cr0, eax

    ; Reinitialize the master PIC at 0x20 and leave only IRQ0 enabled.
    mov al, 0x11
    out 0x20, al
    mov al, 0x20
    out 0x21, al
    mov al, 4
    out 0x21, al
    mov al, 1
    out 0x21, al
    mov al, 0xFE
    out 0x21, al

    ; PIT channel 0, mode 3, divisor 65536 (~18.2 Hz).
    mov al, 0x36
    out 0x43, al
    xor al, al
    out 0x40, al
    out 0x40, al
%else
    ; bemu-nano contract: GDT/PD/CR0/CR3/CR4/segments are already machine state
    ; written by the VMM. There is no PIC or PIT: time advances through hlt.
    mov esp, 0x1000         ; stack0 below the machine's page directory
%endif

    ; ES is the flat kernel-data capability used only by handlers. GS can reach
    ; the VGA page but nothing else. The IDT loop left ECX=0; ECX=0x700
    ; initializes both ring cursors.
    mov ax, 0x10
    mov es, ax
    mov al, 0x28
    mov gs, ax
    mov ch, 7
    mov word [t1frame - 24], 0x20 ; task1's saved EBP carries its DS selector
    ; Keep this six-byte write plus the jump as the final eight bytes before
    ; t1frame: the initial task1 register frame intentionally overlaps them.
    mov [t1frame - 8], ecx
    jmp task0

; task1's initial popad consumes 32 bytes of dead initialization data above;
; iretd consumes this frame. Its stack then cycles within the same 44-byte range.
t1frame:
%ifdef BEMU_CONTRACT
    dd task1                ; flat code: EIP is the absolute entry
    dd 8                    ; contract: machine-supplied flat code identity
%else
    dd 0                    ; offset zero inside the 0x38 code window
    dd 0x38                 ; task1's own code window
%endif
    dd 0x202                ; IF=1

; ---------------------------------------------------------------------- Tasks
; The display is the proof: 3 (displayed by task0), 6 (displayed by task1), and 9
; (the byte appears only because it TRAVELED through the ring; task0 displays 3
; but sends 9). On metal, task0 never sleeps: its loop holds no hlt and no
; yield, so the 6 and the 9 can only exist if IRQ0 interrupted a task that was
; mid-computation. That is asynchronous preemption, the strongest claim a
; timer-preempted 512-byte artifact can make.
task0:
%ifndef BEMU_CONTRACT
    push 0x30              ; task0's code selector
    push 5                 ; offset of task0_flat inside the 0x30 window
    db 0xCB                ; retf: CS=0x30, EIP=5 -- task0 owns its fetches
task0_flat:
%endif
    mov bp, 0x18
    mov ds, bp              ; task0 enters with its own 256-byte data window
    mov ax, 0x0F33          ; white '3'
    db 0x65                 ; GS: VGA-only descriptor
    mov [0], ax
    mov [0], al             ; positive probe: task0 owns physical byte 0x800
%ifdef DOMAIN_FAULT_PROBE
domain_fault:
    mov al, [0x100]         ; task1's byte without IPC: #GP (DS limit is 0xFF)
%endif
%ifdef DOMAIN_CODE_FAULT_PROBE
domain_code_fault:
    jmp task1               ; fetch lands beyond task0's CS limit: #GP13
%endif
    sti
    mov al, 0x39            ; AL='9': the IPC byte, displayed in green by task1
.loop:
    int 33                  ; send(AL)
%ifndef BEMU_CONTRACT
    jmp .loop               ; CPU-bound: task0 spins forever; only IRQ0 preempts
%else
    hlt                     ; contract: time is a machine service; hlt asks for it
    jmp .loop
%endif

task1:
%ifdef DOMAIN_TASK1_FAULT_PROBE
domain_task1_fault:
    mov al, [0x100]         ; first byte beyond task1's 0xFF limit: #GP
%endif
%ifdef IPC_FULL_PROBE
    ; Consume once, then freeze the head at 1. With a correct +24 saved-ECX
    ; lookup, the flooded producer must stop at tail 0 after the wrap.
    int 34
.probe_wait:
    hlt
    jmp .probe_wait
    times 33 - ($ - task1) db 0x90 ; preserve service-handler page/layout
%else
    db 0x65
    mov word [2], 0x0F36    ; white '6' through the VGA-only GS capability
.loop:
    int 34                  ; recv() -> AL, zero if empty
    test al, al
    jz .empty
    mov [0], al             ; positive probe: received byte is private task1 data
    mov ah, 0x0A
    db 0x65
    mov [4], ax             ; green '9' proves end-to-end IPC
.empty:
    hlt
    jmp .loop
%endif

; --------------------------------------------------------- Interrupt handlers
exception_handler:
    hlt                     ; the interrupt gate has already cleared IF
    jmp exception_handler   ; NMI/SMI only returns execution to fail-stop

gp_handler:
    hlt                     ; vector 13 is distinct so the negative probe is exact
    jmp gp_handler

timer_handler:              ; IRQ0 or voluntary yield via int 32
    pushad
%ifndef BEMU_CONTRACT
    mov al, 0x20
    out 0x20, al            ; the yield's spurious EOI is a no-op with an empty ISR
    db 0x26                 ; ES: flat kernel data, never the interrupted task's DS
    db 0xFE, 0x05           ; inc byte [0x6FC] (BASM has no inc-with-memory yet)
    dd 0x6FC                ; heartbeat: every serviced tick leaves a trace
%endif
                            ; contract: there is no PIC and no heartbeat; the
                            ; tick originates in the VMM and time is hlt-requested

do_switch:
    db 0x26
    db 0x87, 0x25           ; xchg esp,[other_sp] (BASM accepts only reg,reg)
    dd other_sp
    popad
    mov ds, bp              ; EBP is part of each task's saved register frame
    iretd

sys_send:                   ; AL=byte; ECX=producer's private cursor
    mov edx, ecx
    inc dl                  ; next tail, modulo 256
    db 0x26
    mov ebx, [other_sp]
    db 0x26
    cmp edx, [ebx + 24]     ; consumer's saved ECX = head
    je .out                 ; full: discard the new byte, leaving the queue intact
    db 0x26
    mov [ecx], al
    mov ecx, edx
.out:
    iretd

sys_recv:                   ; ECX=consumer's private cursor
    xor al, al
    db 0x26
    mov edx, [other_sp]
    db 0x26
    cmp ecx, [edx + 24]     ; producer's saved ECX = tail
    je .out
    db 0x26
    mov al, [ecx]
    inc cl
.out:
    iretd

; ----------------------------------------------------------------------- Data
; Vectors 0..31 are fail-stop; 32=timer/yield, 33=send, 34=recv. An out-of-range
; vector raises #GP, which has a valid gate, rather than escalating to #DF.
idtr:
    dw 35 * 8 - 1
    dd 0x00500

; The GDTR occupies six bytes of the null descriptor. Base-2 makes selector 0x08
; point to the first real descriptor without consuming the null's first two bytes.
; Under the contract, the VMM writes the entire GDT at 0x620 (machine state).
%ifndef BEMU_CONTRACT
gdt:
    dw gdt_end - gdt + 1
    dd gdt - 2
    dw 0xFFFF, 0x0000
    db 0x00, 0x9A, 0xCF, 0x00
    dw 0xFFFF, 0x0000
    db 0x00, 0x92, 0xCF, 0x00
    dw 0x00FF, 0x0800
    db 0x00, 0x92, 0x40, 0x00 ; 0x18: task0 data, base 0x800, limit 0xFF
    dw 0x00FF, 0x0900
    db 0x00, 0x92, 0x40, 0x00 ; 0x20: task1 data, base 0x900, limit 0xFF
    dw 0x0FFF, 0x8000
    db 0x0B, 0x92, 0x40, 0x00 ; 0x28: VGA data, base 0xB8000, limit 0xFFF
    dw task1 - task0 - 1, task0
    db 0x00, 0x9A, 0x40, 0x00 ; 0x30: task0 code, 32-bit, byte granular, DPL0
    dw exception_handler - task1 - 1, task1
    db 0x00, 0x9A, 0x40, 0x00 ; 0x38: task1 code, 32-bit, byte granular, DPL0
gdt_end:
%endif

; While one task runs, this cell contains the other's saved ESP. IPC reads that
; frame's ECX at offset +24, as defined by the pushad layout.
other_sp: dd t1frame - 32

payload_end:
%ifndef BEMU_CONTRACT
    times 510 - ($ - $$) db 0
    dw 0xAA55
%endif
; contract: neither padding nor 0xAA55; the VMM is not a BIOS, and the file is the payload.
