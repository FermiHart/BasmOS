; J-Pack: presentation and typed vocabulary for the 256-byte JASH nucleus.
; It is loaded at DS:0x200, outside module CS, and is never fetched as code.
; SPDX-License-Identifier: BSD-3-Clause
; Copyright (c) 2026, F E R M I ∞ H A R T <contact@fermihart.com>

BITS 32
org 0x200
section .text

    ; Fixed nucleus ABI. Offsets 0..43 are consumed directly by jash.bin.
    dd prompt_zero, prompt_lab
    dd jack_zero, jack_lab
    dd unknown, newline, erase, goodbye, sigil
    dd map_zero, map_lab

; Capability cells. Values >=0x200 emit bounded shipped text; 1/2 are native
; JACK/BYE; 3 is SELECT(deck,map pair). The CPUID field requires cap_attest at
; cell offset 72: the nucleus writes exactly 12 vendor bytes into its ledger.
cap_map:      dd 3
cap_help:     dd help
cap_uname:    dd uname
cap_sigil:    dd sigil
cap_layout:   dd layout
cap_surfaces: dd surfaces
cap_decks:    dd decks
cap_attest:   dd attest
cap_palette:  dd palette
cap_anatomy:  dd anatomy
cap_reserved: dd help
cap_clear:    dd clear
cap_limits:   dd limits
cap_jack:     dd 1
cap_bye:      dd 2

; Fourteen exact words, one semantic operation each. No one-letter aliases and
; no canned counterfactuals disguised as computation.
table:
    dd name_map, cap_map
    dd name_help, cap_help
    dd name_uname, cap_uname
    dd name_sigil, cap_sigil
    dd name_layout, cap_layout
    dd name_surfaces, cap_surfaces
    dd name_decks, cap_decks
    dd name_attest, cap_attest
    dd name_palette, cap_palette
    dd name_anatomy, cap_anatomy
    dd name_clear, cap_clear
    dd name_limits, cap_limits
    dd name_jack, cap_jack
    dd name_bye, cap_bye
    dd 0, 0

name_map:      db "map",0
name_help:     db "help",0
name_uname:    db "uname -a",0
name_sigil:    db "sigil",0
name_layout:   db "layout",0
name_surfaces: db "surfaces",0
name_decks:    db "decks",0
name_attest:   db "attest",0
name_palette:  db "palette",0
name_anatomy:  db "anatomy",0
name_clear:    db "clear",0
name_limits:   db "limits",0
name_jack:     db "jack",0
name_bye:      db "bye",0

; NK-SIGIL/1 is not ornamental randomness. The sixteen braille cells encode
; the first sixteen bytes of SHA256(basmos-sh.bin || jash.bin), dot for bit.
; proofctl recomputes the root and rejects any visual or binary drift.
sigil:
    db 27,"[2J",27,"[H",27,"[38;5;141m"
    db "                        ╱╲",13,10
    db "                 ╱──────◈──────╲",13,10
    db "             ⠒⠽⠛⡛⢇⠚⣎⠕   ∞",13,10
    db "          ◇─────── NK-SIGIL/1 ───────◇",13,10
    db "             ⡉⡉⡃⡕⣛⢦⡒⡧   3·6·9",13,10
    db "                 ╲──────◈──────╱",13,10
    db "                        ╲╱",13,10
    db 27,"[38;5;51m          N A N O K E R N E L",27,"[38;5;46m // JASH",27,"[0m",13,10
    db 27,"[2m  root 123d1b5b871ace15 · artifact-bound · CPL3/002b",27,"[0m",13,10,13,10
    db 27,"[38;5;46m[READY]",27,"[0m 14 exact words · type help",13,10,13,10,0

prompt_zero:
    db 27,"[38;5;46mjash",27,"[38;5;51m@nanokernel.org",27,"[38;5;214m:/zero"
    db 27,"[38;5;201m# ",27,"[0m",27,"[3 q",0
prompt_lab:
    db 27,"[38;5;51mjash",27,"[38;5;45m@nanokernel.org",27,"[38;5;141m:/lab"
    db 27,"[38;5;213m# ",27,"[0m",27,"[3 q",0

newline: db 13,10,0
erase:   db 8," ",8,0
goodbye: db 27,"[0 q",27,"[38;5;46mJASH:EOT",27,"[0m",13,10,0

help:
    db 27,"[38;5;46mEXACT WORDS",27,"[0m",13,10
    db "help      uname -a   attest     sigil",13,10
    db "map       layout     surfaces   decks      limits",13,10
    db "palette   anatomy    clear      jack       bye",13,10
    db 27,"[2mno aliases · exact dispatch",27,"[0m",13,10,0

uname:
    db "JASH/2030 i686 BasmOS capsule cpl3 cs=002b ds=0023",13,10
    db "nucleus=256 pack=DATA-outside-CS kernel=512",13,10,0

surfaces:
    db 27,"[38;5;141mSURFACES / SFC1",27,"[0m",13,10
    db "wire0    Duplex<Byte>       rights=RW",13,10
    db "glyph0   TextOverWire       rights=W",13,10
    db "arena    Region<4096>       rights=RW",13,10
    db "code     CS:RX / DS:RW-alias extent=256",13,10
    db "facts    ConventionStable  physical=RW",13,10
    db "kernel   OutsideUserSegments",13,10,0

decks:
    db 27,"[38;5;214mDECKS / DCK1",27,"[0m",13,10
    db "* zero LIVE  phosphor  map.view=visible",13,10
    db "  lab  READY ice       map.view=masked",13,10
    db "jack toggles a real UI composition bit; not hardware authority",13,10,0

jack_lab:
    db 27,"[38;5;51mJACKED lab",27,"[0m  composition=lab map.view=masked",13,10,0
jack_zero:
    db 27,"[38;5;46mJACKED zero",27,"[0m composition=zero map.view=visible",13,10,0

map_zero:
    db 27,"[38;5;214mLIVE MAP / zero",27,"[0m",13,10
    db "000..0ff nucleus via CS:RX; same arena bytes writable via DS",13,10
    db "100..14f line  180 deck  1fc stack  200..fff J-Pack",13,10
    db "PRF1|VIEW|MAP|ZERO|VISIBLE",13,10,0
map_lab:
    db 27,"[38;5;196mMASKED",27,"[0m map.view by active lab composition",13,10
    db "use jack to restore zero; bytes and hardware permissions unchanged",13,10
    db "PRF1|VIEW|MAP|LAB|MASKED",13,10,0

layout:
    db "ARENA layout: base=00008000 limit=00000fff",13,10
    db "code 000..0ff | line 100..14f | deck 180 | stack 1fc..1ff",13,10
    db "pack 200..fff (3584 max) | kernel outside user segments",13,10,0

limits:
    db "CS 002b base=00008000 limit=000000ff DPL3 execute/read",13,10
    db "DS 0023 base=00008000 limit=00000fff DPL3 read/write",13,10
    db "IOPL=0; cli/out/kernel selectors fault through ring0",13,10,0

palette:
    db 27,"[38;5;46mINT ",27,"[38;5;51mSPAN ",27,"[38;5;214mADDR "
    db 27,"[38;5;201mCAP ",27,"[38;5;196mFAULT ",27,"[38;5;141mSIGIL",27,"[0m",13,10,0

clear:
    db 27,"[2J",27,"[H",0

anatomy:
    db "[ARTIFACT] nucleus=255 reserve=1 CS.limit=FF",13,10
    db "00-42 init 43-47 out 48-88 read 89-8F sel 90-91 late",13,10
    db "92-D3 find D4-E0 jack E1-EC bye ED-F1 rx F2-FE tx",13,10
    db "PRF1|ARTIFACT|JASH|255|1|FF",13,10,0

; The first 21 bytes are fixed: CPUID writes only the vendor placeholder.
attest:
    db "[RUNTIME] cpu.vendor ","????????????",13,10
    db "[RUNTIME] privilege cpl=3 cs=002b",13,10
    db "[ARTIFACT] segments cs=000000ff ds=00000fff iopl=0",13,10
    db "[ARTIFACT] shell basmos-sh.bin 512B",13,10
    db "[ARTIFACT] nucleus jash.bin 256B; Pack outside module CS",13,10
    db "[ROOT] sha256(shell||nucleus) 123d1b5b871ace1549494355dba65267a28d1ba53d6fa860e42f317c894f3da0",13,10
    db "[HASH] shell 4b92dfeebc951d718378b6b11ff97f6577be5d08a4239d1a5064297e638b76a7",13,10
    db "[HASH] jash 3ed12f5d1d90d006522fab676e796441fb870e8b23083dfd6d1907f8693b536d",13,10
    db "[PROOF] expected identities checked externally by proofctl and KVM",13,10
    db "PRF1|ATTEST|NKROOT|123D1B5B871ACE15",13,10,0

unknown:
    db 27,"[38;5;196mNO WORD",27,"[0m exact dispatch; type help",13,10,0

; Host-verifiable binary manifests. Surface entry = kind, rights, base, extent.
evidence_vm_manifest:
    db "EVM1", 1, 4           ; EMIT, JACK, BYE, SELECT

surface_manifest:
    db "SFC1", 6
    db 1, 3
    dw 0, 1                 ; wire0: Duplex<Byte>
    db 2, 2
    dw 0, 1                 ; glyph0: TextOverWire
    db 3, 3
    dw 0, 4096              ; arena: Region<RW,4096>
    db 3, 7
    dw 0, 256               ; code: RX through CS, RW alias through DS
    db 4, 3
    dw 0, 1                 ; facts: physically RW, stable by convention
    db 5, 0
    dw 0, 0                 ; kernel: outside user segments

deck_manifest:
    db "DCK1", 2
    db 0, 1, 0, 0x1F       ; zero: LIVE, phosphor, map visible
    db 1, 2, 1, 0x17       ; lab: READY, ice, map masked

sigil_manifest:
    db "SIG1", 1, 16
    db 0x12,0x3d,0x1b,0x5b,0x87,0x1a,0xce,0x15
    db 0x49,0x49,0x43,0x55,0xdb,0xa6,0x52,0x67

pack_end:
    times 3584 - ($ - $$) db 0
